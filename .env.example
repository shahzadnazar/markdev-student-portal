# Base URL of the Laravel backend REST API (markdev-admin-api).
# The portal consumes ONLY these versioned endpoints: {VITE_API_URL}/api/v1/*
#
# 127.0.0.1, not localhost: `php artisan serve` binds IPv4 only, while Windows
# resolves localhost to ::1 first. The browser then hits [::1]:8000, is refused,
# and the portal reports "Cannot reach the MarkDev server" with no HTTP status.
VITE_API_URL=http://127.0.0.1:8000

# Target used by the Vite dev-server proxy for /api requests (optional).
VITE_PROXY_TARGET=http://127.0.0.1:8000
